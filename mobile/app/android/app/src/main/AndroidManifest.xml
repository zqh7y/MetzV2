<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!--
    READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE and SYSTEM_ALERT_WINDOW were
    template defaults that nothing in this app ever used: there is no image
    picker, no media library, and no overlay. Play reviews the permission list
    against what the app demonstrably does, and SYSTEM_ALERT_WINDOW ("display
    over other apps") is a restricted permission that needs a justification
    this app cannot give. The storage pair is also inert on Android 13+.

    Anything re-adding them here is a dependency asking for them — check which
    before allowing it back.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <!-- The API is reached over plain HTTP on the LAN while it runs on a laptop
       rather than a host with a certificate. Android 9+ blocks cleartext in
       release builds by default, so without this a release APK can reach
       nothing at all. Remove once the backend is served over HTTPS. -->
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:networkSecurityConfig="@xml/network_security_config">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="metz"/>
        <data android:scheme="exp+metz-mobile"/>
        <!-- Google sign-in redirects back to "com.metz.app:/oauthredirect".
             expo-auth-session builds that from the application id (see
             providers/Google.js), and without this filter Android has nothing
             registered for the scheme, so the browser finishes the sign-in and
             then has nowhere to hand it back to. -->
        <data android:scheme="com.metz.app"/>
      </intent-filter>
    </activity>
  </application>
</manifest>