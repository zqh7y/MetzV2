venv/
__pycache__/
*.pyc
flask_session/
metz-firebase.json
.env
.claude/
app_data.db
mysql_data/

# Real user records (encrypted, but still production data — it does not
# belong in the repository, and an encrypted blob is only as private as the
# key in .env stays).
app_data.json
app_data.json.bak

# Signing material. The Android debug keystore is the same on every machine
# and unlocks nothing, but keystores as a class must never be committed —
# a release one would let anyone ship an update as this app.
*.keystore
*.jks
*.p12
# Machine-specific SDK paths
local.properties

# Local runtime artifacts — regenerated on every run, not source
*.log
app_data.db-x-*.bin

# Local notes / generated documents
cmd.md
sources.docx
~$*.docx

# Node
node_modules/

# Database dumps
backups/

# Rendered page snapshots used for visual review
static/_preview/

# Firebase config. Google intends this file to ship inside the APK, so it is
# not a secret in the usual sense — but GitHub's scanner flags the key in it,
# and nothing here actually reads the file: the Google client ids come from
# app.json (extra.googleAuth) and Gradle would look in android/app/, where it
# does not exist. It was vestigial, so it is out of the repo rather than
# sitting there tripping alerts. Regenerate from the Firebase console if a
# future prebuild ever needs it.
mobile/app/google-services.json
