# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── Environment ────────────────────────────────────────────────────────────
# "development" enables debug mode, allows the 1234 verification bypass, and
# drops the Secure flag on cookies so plain-HTTP localhost works.
# Anything else (including unset) is treated as production and hardened.
FLASK_ENV=development

# ─── Secrets ────────────────────────────────────────────────────────────────
# Signs the session cookie. Must be long and random — in production the app
# refuses to start with a weak or known-leaked value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Encrypts meeting/user fields at rest in MySQL.
DATA_ENCRYPTION_KEY=replace-with-a-long-random-string

# ─── Firebase ───────────────────────────────────────────────────────────────
# Web API key. Not a secret (it ships in every client), but restrict it by
# referrer/package in the Google Cloud console.
FIREBASE_API_KEY=your-firebase-web-api-key

# ─── Email (verification codes) ─────────────────────────────────────────────
# A Google account "App Password", not your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ?? PostgreSQL ????????????????????????????????????????????????????????????
# Render supplies this as DATABASE_URL. Use the Internal Database URL for
# Render services; never commit a real URL because it includes the password.
DATABASE_URL=postgresql://metz_app_user:password@host:5432/metz_app

# ─── Mobile API ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the JSON API. "*" is accepted only
# in development; production requires an explicit list.
MOBILE_CORS_ORIGINS=*
